# ============================================
# irumi_quest/skills.ir : 魔法・スキルシステム
# ============================================

（魔法実行 （勇者 敵 呪文名） （
    （もし （呪文名 "ホイミ" 等しい） なら （
        （成功 （勇者 "MP消費" 5 呼ぶ） 覚える）
        （もし （成功 ではない） なら （
            （"MPが足りません！" メッセージ）
            （偽 返す）
        ） もし）
        （勇者 "回復" 30 呼ぶ）
        （真 返す）
    ） ちがえば （
        （もし （呪文名 "メラ" 等しい） なら （
            （成功 （勇者 "MP消費" 6 呼ぶ） 覚える）
            （もし （成功 ではない） なら （
                （"MPが足りません！" メッセージ）
                （偽 返す）
            ） もし）
            （"勇者はメラの呪文を唱えた！火炎球が敵を包む！" メッセージ）
            （敵 "ダメージ受ける" 25 呼ぶ）
            （真 返す）
        ） ちがえば （
            （もし （呪文名 "ギガサンダー" 等しい） なら （
                （成功 （勇者 "MP消費" 14 呼ぶ） 覚える）
                （もし （成功 ではない） なら （
                    （"MPが足りません！" メッセージ）
                    （偽 返す）
                ） もし）
                （"勇者は天空の雷を呼んだ！ギガサンダー炸裂！！" メッセージ）
                （敵 "ダメージ受ける" 60 呼ぶ）
                （真 返す）
            ） ちがえば （
                （"その呪文は覚えられていません。" メッセージ）
                （偽 返す）
            ） もし）
        ） もし）
    ） もし）
） 関数）
