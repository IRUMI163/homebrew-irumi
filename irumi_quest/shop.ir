# ============================================
# irumi_quest/shop.ir : 拠点・道具屋・宿屋システム
# ============================================

（街メニュー （勇者） （
    （街滞在 真 覚える）
    （街滞在 間 （
        （"平穏な冒険者の街" タイトル表示）
        （勇者 "ステータス表示" 呼ぶ）
        （"1: 宿屋に泊まる (20G)" 書く）
        （"2: 道具屋で買い物" 書く）
        （"3: 所持品を見る" 書く）
        （"4: ダンジョンへ出発" 書く）
        （選択 （"行動を選んでください [1-4]: " 聞く） 覚える）

        # 1: 宿屋
        （もし （選択 "1" 等しい） なら （
            （所持金 （勇者 "所持金" 取る） 覚える）
            （もし （所持金 20 小さい） なら （
                （"ゴールドが足りません！" メッセージ）
            ） ちがえば （
                （勇者 "所持金" （所持金 20 引く） 設定）
                （最大H （勇者 "最大HP" 取る） 覚える）
                （最大M （勇者 "最大MP" 取る） 覚える）
                （勇者 "HP" 最大H 設定）
                （勇者 "MP" 最大M 設定）
                （"ぐっすり眠った... HPとMPが全回復した！" タイトル表示）
            ） もし）
        ） ちがえば （
            # 2: 道具屋
            （もし （選択 "2" 等しい） なら （
                （勇者 道具屋メニュー）
            ） ちがえば （
                # 3: 所持品確認
                （もし （選択 "3" 等しい） なら （
                    （勇者 所持品メニュー）
                ） ちがえば （
                    # 4: 出発
                    （もし （選択 "4" 等しい） なら （
                        （"ダンジョンへ向かいます！気を引き締めて行こう！" メッセージ）
                        （街滞在 偽 覚える）
                    ） もし）
                ） もし）
            ） もし）
        ） もし）
    ） 繰り返す）
） 関数）

（道具屋メニュー （勇者） （
    （買い物中 真 覚える）
    （買い物中 間 （
        （細い線）
        （"【道具屋】 いらっしゃい！何を買うんだい？" 書く）
        （所持金 （勇者 "所持金" 取る） 覚える）
        （（"所持金: " 所持金 " G" 足す） 書く）
        （"1: やくそう (25G) - HPを35回復" 書く）
        （"2: まほうのせいすい (50G) - MPを20回復" 書く）
        （"3: ちからのたね (150G) - 攻撃力+3" 書く）
        （"0: 店を出る" 書く）
        （買物品 （"購入する番号を入力: " 聞く） 覚える）

        （もし （買物品 "0" 等しい） なら （
            （買い物中 偽 覚える）
        ） ちがえば （
            （もし （買物品 "1" 等しい） なら （
                （勇者 "やくそう" 25 商品購入）
            ） ちがえば （
                （もし （買物品 "2" 等しい） なら （
                    （勇者 "まほうのせいすい" 50 商品購入）
                ） ちがえば （
                    （もし （買物品 "3" 等しい） なら （
                        （勇者 "ちからのたね" 150 商品購入）
                    ） もし）
                ） もし）
            ） もし）
        ） もし）
    ） 繰り返す）
） 関数）

（商品購入 （勇者 商品名 価格） （
    （所持金 （勇者 "所持金" 取る） 覚える）
    （もし （所持金 価格 小さい） なら （
        （"ゴールドが足りないよ！" メッセージ）
    ） ちがえば （
        （勇者 "所持金" （所持金 価格 引く） 設定）
        （商品名 道具手に入れる）
        （"まいどあり！" メッセージ）
    ） もし）
） 関数）
