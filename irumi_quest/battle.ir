# ============================================
# irumi_quest/battle.ir : ターン制コマンド戦闘システム
# ============================================

（戦闘実行 （勇者 敵） （
    （敵名 （敵 "名前" 取る） 覚える）
    （区切り線）
    （（"！！ " 敵名 " があらわれた！ ！！" 足す） タイトル表示）
    （区切り線）

    （戦闘継続 真 覚える）
    （逃走成功 偽 覚える）

    （戦闘継続 間 （
        （勇者 "ステータス表示" 呼ぶ）
        （敵HP （敵 "HP" 取る） 覚える）
        （敵最大HP （敵 "最大HP" 取る） 覚える）
        （（"【敵】 " 敵名 " HP: " 敵HP "/" 敵最大HP 足す） 書く）
        （細い線）
        （"1: たたかう | 2: じゅもん | 3: どうぐ | 4: にげる" 書く）
        （行動 （"コマンドを選んでください [1-4]: " 聞く） 覚える）

        # 勇者の行動
        （ターン消費 偽 覚える）

        # 1: たたかう
        （もし （行動 "1" 等しい） なら （
            （勇者名 （勇者 "名前" 取る） 覚える）
            （（勇者名 " の攻撃！" 足す） メッセージ）
            （会心ガチャ （1 6 乱数） 覚える）
            （与ダメ （勇者 "攻撃力" 取る） 覚える）
            （もし （会心ガチャ 6 等しい） なら （
                （"★★★ 会心の一撃！！！ ★★★" タイトル表示）
                （与ダメ （与ダメ 2 掛ける） 覚える）
            ） もし）
            （敵 "ダメージ受ける" 与ダメ 呼ぶ）
            （ターン消費 真 覚える）
        ） ちがえば （
            # 2: じゅもん
            （もし （行動 "2" 等しい） なら （
                （"どの呪文を唱えますか？ (1: ホイミ(MP5) | 2: メラ(MP6) | 3: ギガサンダー(MP14))" 書く）
                （呪文選択 （"番号: " 聞く） 覚える）
                （選択呪文名 "" 覚える）
                （もし （（呪文選択 "1" 等しい） または （呪文選択 "ホイミ" 等しい）） なら （選択呪文名 "ホイミ" 覚える） もし）
                （もし （（呪文選択 "2" 等しい） または （呪文選択 "メラ" 等しい）） なら （選択呪文名 "メラ" 覚える） もし）
                （もし （（呪文選択 "3" 等しい） または （呪文選択 "ギガサンダー" 等しい）） なら （選択呪文名 "ギガサンダー" 覚える） もし）
                （もし （選択呪文名 "" 違う） なら （
                    （魔法結果 （勇者 敵 選択呪文名 魔法実行） 覚える）
                    （もし 魔法結果 なら （ターン消費 真 覚える） もし）
                ） ちがえば （
                    （"呪文をキャンセルしました。" メッセージ）
                ） もし）
            ） ちがえば （
                # 3: どうぐ
                （もし （行動 "3" 等しい） なら （
                    （所持品一覧表示）
                    （袋長さ （所持品袋 長さ） 覚える）
                    （もし （袋長さ 0 等しい） なら （
                        （0.5 待つ）
                    ） ちがえば （
                        （道具番号文字 （"使う道具の番号を入力 (cで戻る): " 聞く） 覚える）
                        （もし （道具番号文字 "c" 違う） なら （
                            （インデックス （道具番号文字 数値化） 覚える）
                            （もし （（インデックス 0 以上） かつ （インデックス 袋長さ 小さい）） なら （
                                （道具名 （所持品袋 インデックス 番目） 覚える）
                                （所持品袋 インデックス 消す）
                                （勇者 道具名 道具使用）
                                （ターン消費 真 覚える）
                            ） ちがえば （
                                （"正しい道具の番号を入力してください。" メッセージ）
                            ） もし）
                        ） もし）
                    ） もし）
                ） ちがえば （
                    # 4: にげる
                    （もし （行動 "4" 等しい） なら （
                        （勇者名 （勇者 "名前" 取る） 覚える）
                        （（勇者名 " は逃げ出した！" 足す） メッセージ）
                        （逃げガチャ （1 2 乱数） 覚える）
                        （もし （逃げガチャ 1 等しい） なら （
                            （"うまく逃げ切れた！" メッセージ）
                            （戦闘継続 偽 覚える）
                            （逃走成功 真 覚える）
                        ） ちがえば （
                            （"しかし回り込まれてしまった！" メッセージ）
                            （ターン消費 真 覚える）
                        ） もし）
                    ） ちがえば （
                        （"正しい番号を入力してください。" メッセージ）
                    ） もし）
                ） もし）
            ） もし）
        ） もし）

        # 敵の撃破チェック
        （もし （（敵 "生存確認" 呼ぶ） ではない） なら （
            （戦闘継続 偽 覚える）
            （区切り線）
            （（"★ " 敵名 " を倒した！ ★" 足す） タイトル表示）
            （敵経験値 （敵 "経験値" 取る） 覚える）
            （敵金 （敵 "ゴールド" 取る） 覚える）
            （勇者 "経験値獲得" 敵経験値 呼ぶ）
            （現金 （勇者 "所持金" 取る） 覚える）
            （勇者 "所持金" （現金 敵金 足す） 設定）
            （（敵金 " Gを手に入れた！" 足す） メッセージ）
            （真 返す）
        ） もし）

        # 敵のターン
        （もし （戦闘継続 かつ ターン消費） なら （
            （細い線）
            （（敵名 " の攻撃！" 足す） メッセージ）
            （敵攻撃力 （敵 "攻撃力" 取る） 覚える）
            （敵ダメ （敵攻撃力 （1 4 乱数） 足す） 覚える）
            （勇者 "ダメージ受ける" 敵ダメ 呼ぶ）
            
            # 勇者死亡チェック
            （もし （（勇者 "生存確認" 呼ぶ） ではない） なら （
                （戦闘継続 偽 覚える）
                （"★★★ 勇者は力尽きてしまった... ★★★" タイトル表示）
                （偽 返す）
            ） もし）
        ） もし）
    ） 繰り返す）

    （もし 逃走成功 なら （真 返す） もし）
    （偽 返す）
） 関数）
