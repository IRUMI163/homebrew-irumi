# ============================================
# irumi_quest/player.ir : プレイヤー（勇者）設計図
# ============================================

（勇者 （名前初期値） （
    （名前 名前初期値 覚える）
    （レベル 1 覚える）
    （最大HP 50 覚える）
    （HP 50 覚える）
    （最大MP 20 覚える）
    （MP 20 覚える）
    （攻撃力 12 覚える）
    （防御力 5 覚える）
    （経験値 0 覚える）
    （所持金 100 覚える）

    # ダメージを受ける
    （ダメージ受ける （量） （
        （実ダメージ （量 防御力 引く） 覚える）
        （もし （実ダメージ 1 小さい） なら （実ダメージ 1 覚える） もし）
        （HP （HP 実ダメージ 引く） 覚える）
        （もし （HP 0 小さい） なら （HP 0 覚える） もし）
        （（名前 "は " 実ダメージ " のダメージを受けた！（残りHP: " HP "）" 足す） メッセージ）
        （HP 返す）
    ） 関数）

    # HPを回復する
    （回復 （量） （
        （HP （HP 量 足す） 覚える）
        （もし （HP 最大HP 大きい） なら （HP 最大HP 覚える） もし）
        （（名前 "のHPが " 量 " 回復した！（現在HP: " HP "）" 足す） メッセージ）
    ） 関数）

    # MPを消費する
    （MP消費 （量） （
        （もし （MP 量 小さい） なら （偽 返す） もし）
        （MP （MP 量 引く） 覚える）
        （真 返す）
    ） 関数）

    # 経験値を獲得してレベルアップ
    （経験値獲得 （量） （
        （経験値 （経験値 量 足す） 覚える）
        （（量 " の経験値を手に入れた！" 足す） メッセージ）
        （必要経験値 （レベル 20 掛ける） 覚える）
        （もし （経験値 必要経験値 以上） なら （
            （レベル （レベル 1 足す） 覚える）
            （最大HP （最大HP 15 足す） 覚える）
            （HP 最大HP 覚える）
            （最大MP （最大MP 8 足す） 覚える）
            （MP 最大MP 覚える）
            （攻撃力 （攻撃力 4 足す） 覚える）
            （防御力 （防御力 2 足す） 覚える）
            （（"★ レベルアップ！ レベル " レベル " になった！ ★" 足す） タイトル表示）
        ） もし）
    ） 関数）

    # ステータス表示
    （ステータス表示 （） （
        （細い線）
        （（"【勇者 " 名前 "】 Lv:" レベル " | HP:" HP "/" 最大HP " | MP:" MP "/" 最大MP " | 所持金:" 所持金 "G" 足す） 書く）
        （細い線）
    ） 関数）

    # 生存しているか判定
    （生存確認 （） （
        （HP 0 大きい 返す）
    ） 関数）
） 設計図）
