{
  "If Statement": {
    "prefix": ["もし", "if"],
    "body": [
      "（もし （${1:条件}） なら",
      "    ${2:処理}",
      "ちがえば",
      "    ${3:処理}）"
    ],
    "description": "条件分岐 (もし 〜 なら 〜 ちがえば)"
  },
  "Function Definition": {
    "prefix": ["関数", "かんすう", "def", "fn"],
    "body": [
      "（${1:関数名} （${2:引数}） （",
      "    ${3:処理}",
      "） 関数）"
    ],
    "description": "関数定義 (関数)"
  },
  "Blueprint Definition": {
    "prefix": ["設計図", "せっけいず", "クラス", "class"],
    "body": [
      "（${1:クラス名} （${2:初期化引数}） （",
      "    ${3:# プロパティとメソッドの定義}",
      "） 設計図）"
    ],
    "description": "設計図（クラス）定義"
  },
  "Range Loop": {
    "prefix": ["繰り返す-範囲", "くりかえす-はんい"],
    "body": [
      "（${1:1} から ${2:10} まで 各 ${3:i} （",
      "    ${4:処理}",
      "） 繰り返す）"
    ],
    "description": "範囲ループ (〜から〜まで)"
  },
  "Foreach Loop": {
    "prefix": ["繰り返す-各要素", "くりかえす-かくようそ"],
    "body": [
      "（${1:リスト} の各要素を ${2:要素} （",
      "    ${3:処理}",
      "） 繰り返す）"
    ],
    "description": "各要素巡回ループ (の各要素を)"
  },
  "Try-Catch Block": {
    "prefix": ["試す", "ためす", "try"],
    "body": [
      "（",
      "    ${1:実行する処理}",
      "失敗したら エラー内容 （",
      "    ${2:エラー時処理}",
      "） かならず （",
      "    ${3:最終処理}",
      "） 試す）"
    ],
    "description": "例外処理 (試す 〜 失敗したら 〜 かならず)"
  }
}
